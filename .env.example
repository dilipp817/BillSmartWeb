# BillSmart Web — Environment Variables
# Copy this to .env.local and fill in the values. Never commit .env.local.

# ──────────────────────────────────────────
# SERVER-SIDE ONLY (never exposed to browser)
# ──────────────────────────────────────────

# Spring Boot backend base URL.
# All browser calls go through Next.js /api/... proxy — this URL stays server-side.
# Per flavor × variant:
#   smartPos   dev/uat : https://billsmart-uwad.onrender.com/api/v1
#   smartPos   prod    : https://billsmart-api.onrender.com/api/v1
#   jevnarSweets dev   : https://jevnarsweets-dev.example.com/api/v1
#   jevnarSweets uat   : https://jevnarsweets-uat.example.com/api/v1
#   jevnarSweets prod  : https://jevnarsweets.example.com/api/v1
API_BASE_URL=https://billsmart-uwad.onrender.com

# Optional: shared secret for internal Next.js → Spring Boot proxy calls.
# Must be at least 32 characters. Generate with: openssl rand -hex 32
# API_INTERNAL_SECRET=

# Build variant — identifies which deploy environment this instance is running as.
# Used for server-side logging and monitoring. Values: dev | uat | prod
APP_ENV=dev

# ──────────────────────────────────────────
# CLIENT-SIDE (NEXT_PUBLIC_ prefix — visible in browser bundle)
# ──────────────────────────────────────────

# Canonical app URL (used for redirects, meta tags, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# App display name shown in the UI
NEXT_PUBLIC_APP_NAME=BillSmart

# Client flavor — identifies which business this deployment serves.
# Drives branding: logo, display name, color theme.
# Values: smartPos | jevnarSweets
NEXT_PUBLIC_FLAVOR=smartPos
